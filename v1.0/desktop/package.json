{
  "name": "@assessly/desktop",
  "version": "1.0.0",
  "description": "Assessly desktop app for lockdown assessments",
  "license": "ISC",
  "author": "Assessly",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electronmon .",
    "start": "electron .",
    "build:win": "npm run build:web && electron-builder --win --config electron-builder.yml",
    "build:mac": "npm run build:web && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.20.0",
    "ps-list": "^8.1.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4"
  },
  "electronmon": {
    "patterns": [
      "src/**/*.js"
    ]
  }
}
